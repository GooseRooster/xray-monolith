# exclude all dot files except .gitignore
.*
!.gitignore
!.gitattributes

# Track the upstream-merge skills + shared ledger; leave everything else
# under .claude/ (settings.local.json, other local state, etc.) ignored.
!.claude/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/README.md
!.claude/skills/upstream-merge-triage/
!.claude/skills/upstream-merge-review/
!.claude/skills/upstream-merge-apply/
!.claude/skills/upstream-merge-gamedata/
!.claude/upstream-merge/
.claude/skills/*/scripts/__pycache__/

# upstream-merge-gamedata's pointer to your private gamedata repo's
# location on disk - deliberately local-only, never committed. See
# .claude/skills/upstream-merge-gamedata/references/gamedata-protocol.md.
.claude/upstream-merge/gamedata-review.local.json

# exclude binaries and temporary files
_build/
/compile_commands.json
/src/*.tss
/**/x64/
**/.vs/
*.pdb
*.ilk
*.user
*.VC.db
*.VC.opendb
lua51.dll
lua51.exp
lua51.lib
luajit.exe

# luajit generated files
src/3rd party/luajit-2/src/lj_bcdef.h
src/3rd party/luajit-2/src/lj_ffdef.h
src/3rd party/luajit-2/src/lj_folddef.h
src/3rd party/luajit-2/src/lj_libdef.h
src/3rd party/luajit-2/src/lj_recdef.h
src/3rd party/luajit-2/src/host/buildvm_arch.h
src/3rd party/luajit-2/src/jit/vmdef.lua
src/3rd party/luajit-2/src/intermediate/
src/3rd party/luajit-2/src/*.obj
src/3rd party/luajit-2/src/*.pdb
src/3rd party/luajit-2/src/host/*.exe

# compressor runtime artifacts
compressor/engine.log
compressor/mod/

# emacs temp file
\#*\#
*~
config
HEAD
hooks
objects
refs
